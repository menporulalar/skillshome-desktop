# Generated by Cargo
# will have compiled files and executables
/target/

# Generated by Tauri
# will have schema files for capabilities auto-completion
/gen/schemas

# Dev-machine-local build-time secrets (e.g. GOOGLE_DESKTOP_CLIENT_ID), loaded by
# build.rs — never commit real client IDs/keys.
/.env

# Bundled sidecar (release packaging) — build.rs writes empty placeholders here
# for local dev; release.yml overwrites with a real node binary + esbuild output
# before `tauri build`. Never committed either way.
/resources/sidecar/
